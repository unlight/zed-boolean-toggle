[
  {
    "context": "Editor",
    "bindings": {
      "ctrl-alt-x": [
        "assistant::InsertIntoEditor",
        { "text": "/toggle-bool ${ZED_SELECTED_TEXT}" }
      ]
    }
  },
  {
    "context": "Editor && language == Markdown",
    "bindings": {
      "ctrl-alt-x": [
        "assistant::InsertIntoEditor",
        { "text": "/toggle-bool ${ZED_SELECTED_TEXT} --lang=Markdown" }
      ]
    }
  }
]
